# Copy to .env and fill in. Never commit .env.

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# From console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: comma-separated Telegram chat IDs allowed to use the bot.
# Owner and allowlisted chats have unlimited access; other users need an active pilot.
ALLOWED_CHAT_IDS=

# Optional: model overrides
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional fallback: Nous Portal (used only when Anthropic fails)
NOUS_API_KEY=
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
NOUS_MODEL=anthropic/claude-sonnet-5-5

# Phase 2 quality engine (see docs/AI_QUALITY_ENGINE.md for all bounds)
QUALITY_THRESHOLD=7.5
QUALITY_DIMENSION_FLOOR=6.0
QUALITY_MAX_REVISIONS=1
QUALITY_MAX_CALLS=5
QUALITY_TIMEOUT_SECONDS=120
QUALITY_CALL_TIMEOUT_SECONDS=45
QUALITY_MAX_COST_USD=0.25
QUALITY_MAX_INPUT_CHARS=100000
QUALITY_MAX_TOTAL_OUTPUT_TOKENS=15000
QUALITY_WRITER_TOKENS=4000
QUALITY_REVIEW_TOKENS=1800
QUALITY_ANALYST=true

# Enforce review JSON on documented Claude models; local validation is always mandatory.
QUALITY_STRUCTURED_REVIEW=true

# Compact provider-constrained analyst envelope; no extra planning calls.
QUALITY_STRUCTURED_ANALYST=true
# User-authorized labeled drafts only after a fresh all-pass mandatory-gate review.
QUALITY_SHOW_REVIEW_DRAFTS=true
